POLYMARKET_CLI=polymarket-cli
LOOP_INTERVAL_SECONDS=2
DEFAULT_ORDER_USD=24
MAX_SIMULTANEOUS_POSITIONS=50
MIN_SIMULTANEOUS_POSITIONS=20
SPREAD_ARB_THRESHOLD=0.99
SPREAD_ARB_AGGRESSIVE_THRESHOLD=0.985
MOMENTUM_WINDOW_SECONDS=60
MOMENTUM_THRESHOLD_PCT=0.00125
VOLUME_SPIKE_MULTIPLIER=1.4
LATE_ENTRY_MIN_SECONDS=30
LATE_ENTRY_MAX_SECONDS=180
HARD_REVERSAL_THRESHOLD_PCT=0.0010
TAKE_PROFIT_PRICE=0.90
BASE_SYMBOLS=BTCUSDT,ETHUSDT
OPTIONAL_SYMBOLS=SOLUSDT,XRPUSDT
LOG_FILE=logs/trades.jsonl

# Command templates (adjust if your polymarket-cli syntax differs)
LIST_MARKETS_CMD={cli} markets list --status active --json
ORDERBOOK_CMD={cli} markets orderbook --market-id {market_id} --json
CREATE_ORDER_CMD={cli} orders create --market-id {market_id} --outcome {outcome} --side buy --order-type limit --price {price} --size {size} --json
CANCEL_ORDER_CMD={cli} orders cancel --order-id {order_id} --json
POSITIONS_CMD={cli} positions list --json
OPEN_ORDERS_CMD={cli} orders list --status open --json
